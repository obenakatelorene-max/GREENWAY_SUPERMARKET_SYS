{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A supermarket product",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock_quantity": { "type": "number" },
        "min_stock_level": { "type": "number" },
        "image_url": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sku", "category", "price", "cost", "stock_quantity"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A transaction record",
      "type": "object",
      "properties": {
        "subtotal": { "type": "number" },
        "tax_amount": { "type": "number" },
        "discount_amount": { "type": "number" },
        "total_amount": { "type": "number" },
        "total_cost": { "type": "number" },
        "profit": { "type": "number" },
        "payment_method": { "type": "string", "enum": ["cash", "card", "mobile_money"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["total_amount", "tax_amount", "payment_method", "total_cost", "profit"]
    },
    "SaleItem": {
      "title": "Sale Item",
      "description": "An item within a sale",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "product_name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit_price": { "type": "number" },
        "unit_cost": { "type": "number" },
        "total_price": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "product_name", "quantity", "unit_price", "unit_cost", "total_price"]
    },
    "StockMovement": {
      "title": "Stock Movement",
      "description": "Record of stock changes",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out", "adjustment"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "An operational expense",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["utilities", "salaries", "supplies", "maintenance", "miscellaneous"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "category", "amount", "date", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Main product catalog"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Transaction headers"
    },
    "/sales/{saleId}/items/{itemId}": {
      "schema": "SaleItem",
      "description": "Individual items per transaction"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operational expenses"
    }
  }
}
